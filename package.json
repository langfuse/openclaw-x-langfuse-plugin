{
  "name": "openclaw-x-langfuse-plugin",
  "version": "1.4.0",
  "description": "Forward OpenClaw model usage diagnostics to Langfuse",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "mapping.js",
    "tracer.js",
    "transcript.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "runtimeExtensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.1"
    },
    "build": {
      "openclawVersion": "2026.6.1"
    },
    "install": {
      "clawhubSpec": "clawhub:openclaw-x-langfuse-plugin",
      "npmSpec": "openclaw-x-langfuse-plugin",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "langfuse",
    "observability",
    "llm",
    "tracing",
    "diagnostics"
  ],
  "author": "Caleb Seeling <caleb.seeling@clickhouse.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfuse/openclaw-x-langfuse-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/langfuse/openclaw-x-langfuse-plugin/issues"
  },
  "homepage": "https://github.com/langfuse/openclaw-x-langfuse-plugin#readme",
  "dependencies": {
    "@langfuse/otel": "^5.9.0",
    "@langfuse/tracing": "^5.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.8.0"
  }
}
